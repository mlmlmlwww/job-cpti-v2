<view class="container quiz-container" wx:if="{{!loading}}">
  <view class="progress-section">
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{progress}}%"></view>
    </view>
    <view class="progress-text">{{currentIndex + 1}} / {{questions.length}}</view>
  </view>

  <view class="question-section">
    <view class="question-number">Q{{currentQuestion.order}}</view>
    <view class="question-content">{{currentQuestion.content}}</view>
  </view>

  <view class="options-section">
    <view
      class="option-item {{answers[currentIndex] === (index + 1) ? 'selected' : ''}}"
      wx:for="{{options}}"
      wx:key="index"
      data-value="{{index + 1}}"
      bindtap="onSelectOption"
    >
      <view class="option-label">{{item}}</view>
      <view class="option-tip">{{optionTips[index]}}</view>
    </view>
  </view>

  <view class="footer-section" wx:if="{{currentIndex > 0}}">
    <view class="prev-btn" bindtap="onPrev">← 上一题</view>
  </view>
</view>

<view class="loading-view" wx:if="{{loading}}">
  <view class="loading-text">加载中...</view>
</view>

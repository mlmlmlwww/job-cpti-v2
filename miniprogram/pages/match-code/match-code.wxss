.match-container {
  padding: 120rpx 32rpx;
}
.title-section { text-align: center; margin-bottom: 80rpx; }
.title {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 16rpx;
}
.subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
}
.input-section { margin-bottom: 60rpx; }
.code-input {
  width: 100%;
  height: 140rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 2rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 20rpx;
  font-size: 60rpx;
  color: #ffd166;
  text-align: center;
  letter-spacing: 20rpx;
  font-family: monospace;
  padding: 0 20rpx;
  box-sizing: border-box;
}
.cta-section { padding: 0 20rpx; }
.main-btn { width: 100%; }

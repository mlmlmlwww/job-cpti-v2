.invite-container {
  padding: 120rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.inviter-section {
  text-align: center;
  margin-bottom: 100rpx;
}

.inviter-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(240, 147, 251, 0.5);
  margin-bottom: 24rpx;
}

.inviter-name {
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.inviter-tip {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

.teaser-section {
  text-align: center;
  margin-bottom: 120rpx;
}

.teaser-question {
  font-size: 44rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-bottom: 24rpx;
  font-weight: 500;
}

.teaser-highlight {
  font-size: 52rpx;
  font-weight: 900;
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  margin-bottom: 40rpx;
  line-height: 1.4;
}

.teaser-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
  padding: 0 40rpx;
  line-height: 1.6;
}

.cta-section {
  width: 100%;
}

.main-btn {
  width: 100%;
}

.home-container {
  padding-top: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand-section {
  text-align: center;
  margin-bottom: 180rpx;
}

.brand-logo {
  font-size: 100rpx;
  font-weight: 900;
  letter-spacing: 10rpx;
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 50%, #ffd166 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  margin-bottom: 40rpx;
}

.brand-tagline {
  font-size: 40rpx;
  color: #fff;
  font-weight: 500;
  margin-bottom: 20rpx;
  letter-spacing: 2rpx;
}

.brand-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
}

.cta-section {
  width: 100%;
  padding: 0 32rpx;
  margin-bottom: 120rpx;
}

.main-btn {
  width: 100%;
  margin-bottom: 24rpx;
}

.footer-section {
  text-align: center;
  padding-bottom: 80rpx;
}

.footer-link {
  margin-bottom: 20rpx;
  padding: 12rpx;
  color: rgba(255, 255, 255, 0.65);
  font-size: 26rpx;
}

.footer-tip {
  color: rgba(255, 255, 255, 0.35);
  font-size: 22rpx;
  margin-top: 20rpx;
}

.result-container {
  padding: 40rpx 32rpx 80rpx;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 人格主视觉 */
.persona-hero-card {
  background: linear-gradient(135deg, rgba(240, 147, 251, 0.15) 0%, rgba(245, 87, 108, 0.15) 100%);
  border: 2rpx solid rgba(240, 147, 251, 0.3);
  border-radius: 32rpx;
  padding: 60rpx 40rpx;
  margin-bottom: 40rpx;
  text-align: center;
  box-shadow: 0 12rpx 40rpx rgba(245, 87, 108, 0.2);
}

.hero-image-wrap {
  width: 320rpx;
  height: 320rpx;
  border-radius: 24rpx;
  overflow: hidden;
  margin: 0 auto 40rpx;
  background: rgba(255, 255, 255, 0.06);
}

.hero-image {
  width: 100%;
  height: 100%;
}

.hero-image-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(240, 147, 251, 0.3) 0%, rgba(245, 87, 108, 0.3) 100%);
}

.placeholder-emoji {
  font-size: 120rpx;
  font-weight: 900;
  color: rgba(255, 255, 255, 0.6);
}

.hero-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 24rpx;
  letter-spacing: 4rpx;
}

.hero-name {
  font-size: 96rpx;
  font-weight: 900;
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 50%, #ffd166 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  margin-bottom: 32rpx;
  line-height: 1.2;
  letter-spacing: 4rpx;
}

.hero-slogan {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.7;
  padding: 0 20rpx;
}

/* 匹配码卡片 */
.match-code-card {
  background: rgba(255, 255, 255, 0.06);
  border: 2rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 40rpx;
  text-align: center;
}

.match-code-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 20rpx;
}

.match-code-value {
  font-size: 88rpx;
  font-weight: 900;
  color: #ffd166;
  letter-spacing: 12rpx;
  padding: 12rpx 0;
  font-family: monospace;
}

.match-code-tip {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-top: 16rpx;
}

.cta-section { margin-bottom: 40rpx; }
.main-btn { width: 100%; margin-bottom: 24rpx; }

.footer-section {
  text-align: center;
  padding-top: 20rpx;
}

.text-link {
  color: rgba(255, 255, 255, 0.55);
  font-size: 26rpx;
  padding: 20rpx;
}

.loading-view {
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
}
.loading-text { color: rgba(255, 255, 255, 0.6); }

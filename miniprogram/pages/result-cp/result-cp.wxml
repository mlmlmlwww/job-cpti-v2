<view class="container cp-container" wx:if="{{!loading && cpData}}">
  <!-- CP主视觉图 -->
  <view class="cp-hero-card">
    <view class="cp-image-wrap">
      <image
        wx:if="{{cpData.shareImage}}"
        class="cp-image"
        src="{{cpData.shareImage}}"
        mode="aspectFill"
      ></image>
      <view wx:else class="cp-image-placeholder">
        <view class="placeholder-text">CP</view>
      </view>
    </view>

    <view class="cp-title-section">
      <view class="cp-persona-names">
        <text class="persona-name-left">{{cpData.userA.personaName}}</text>
        <text class="cp-x">×</text>
        <text class="persona-name-right">{{cpData.userB.personaName}}</text>
      </view>
      <view class="cp-name">{{cpData.cpName}}</view>
      <view class="cp-you-info" wx:if="{{meIntro || otherIntro}}">
        <view class="cp-you-line" wx:if="{{meIntro}}">{{meIntro}}</view>
        <view class="cp-you-line" wx:if="{{otherIntro}}">{{otherIntro}}</view>
      </view>
      <view class="cp-description">{{cpData.cpDescription}}</view>
    </view>
  </view>

  <!-- CTA -->
  <view class="cta-section">
    <button class="btn-primary main-btn" open-type="share">
      分享我的CP
    </button>
    <button class="btn-secondary main-btn" bindtap="onInputCode">
      测试其他 CP
    </button>
  </view>

  <!-- 4 维度双方对比（放在 CTA 之后） -->
  <view class="dim-card" wx:if="{{dimRows.length > 0}}">
    <view class="dim-title">4 维画像对比</view>
    <view class="dim-legend">
      <view class="legend-item"><view class="legend-dot me"></view><text>你</text></view>
      <view class="legend-item"><view class="legend-dot other"></view><text>TA</text></view>
    </view>
    <view class="dim-cmp-row" wx:for="{{dimRows}}" wx:key="name">
      <view class="dim-name">{{item.name}}</view>
      <view class="dim-cmp-bars">
        <view class="dim-track">
          <view class="dim-center-line"></view>
          <view
            class="dim-fill {{item.meDirection === 'pos' ? 'pos' : 'neg'}} me"
            style="width: {{item.meRatioPct / 2}}%"
          ></view>
        </view>
        <view class="dim-track">
          <view class="dim-center-line"></view>
          <view
            class="dim-fill {{item.otherDirection === 'pos' ? 'pos' : 'neg'}} other"
            style="width: {{item.otherRatioPct / 2}}%"
          ></view>
        </view>
      </view>
    </view>
  </view>

  <view class="footer-section">
    <view class="text-link" bindtap="onGoHome">返回首页 ›</view>
  </view>

  <!-- 小程序码 -->
  <image class="qrcode-float" src="{{qrcodePath}}" mode="aspectFit"></image>
</view>

<view class="loading-view" wx:if="{{loading}}">
  <view class="loading-text">加载中...</view>
</view>

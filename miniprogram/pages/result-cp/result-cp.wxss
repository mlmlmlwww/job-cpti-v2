.cp-container {
  padding: 40rpx 32rpx 80rpx;
  min-height: 100vh;
}

.cp-hero-card {
  background: linear-gradient(135deg, rgba(240, 147, 251, 0.15) 0%, rgba(245, 87, 108, 0.15) 100%);
  border: 2rpx solid rgba(240, 147, 251, 0.3);
  border-radius: 32rpx;
  padding: 40rpx 32rpx 60rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 12rpx 40rpx rgba(245, 87, 108, 0.2);
}

.cp-image-wrap {
  width: 100%;
  aspect-ratio: 1 / 1;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 40rpx;
  background: rgba(255, 255, 255, 0.06);
}
.cp-image { width: 100%; height: 100%; }

.cp-image-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(240, 147, 251, 0.3) 0%, rgba(255, 209, 102, 0.3) 100%);
}

.placeholder-text {
  font-size: 120rpx;
  font-weight: 900;
  color: rgba(255, 255, 255, 0.6);
  letter-spacing: 10rpx;
}

.cp-title-section { text-align: center; }

.cp-persona-names {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 32rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20rpx;
}

.cp-x {
  color: #f5576c;
  font-size: 40rpx;
  font-weight: 700;
}

.persona-name-left, .persona-name-right {
  color: #fff;
  font-weight: 600;
}

.cp-name {
  font-size: 72rpx;
  font-weight: 900;
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 50%, #ffd166 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  margin-bottom: 32rpx;
  line-height: 1.2;
  letter-spacing: 4rpx;
}

.cp-description {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.7;
  padding: 0 20rpx;
  text-align: left;
}

.cp-you-info {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.75);
  line-height: 1.6;
  padding: 0 20rpx;
  margin-bottom: 20rpx;
  text-align: left;
}

.cp-you-line { margin-bottom: 8rpx; }
.cp-you-line:last-child { margin-bottom: 0; }

/* 4 维度双方对比 */
.dim-card {
  background: rgba(255, 255, 255, 0.06);
  border: 2rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 40rpx;
}

.dim-title {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
}

.dim-legend {
  display: flex;
  gap: 32rpx;
  margin-bottom: 20rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}
.legend-item { display: flex; align-items: center; gap: 8rpx; }
.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
}
.legend-dot.me { background: #f093fb; }
.legend-dot.other { background: #ffd166; }

.dim-cmp-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.dim-cmp-row:last-child { margin-bottom: 0; }

.dim-name {
  width: 96rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  flex-shrink: 0;
}

.dim-cmp-bars {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.dim-track {
  height: 14rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 7rpx;
  position: relative;
  overflow: hidden;
}

.dim-center-line {
  display: none;
}

.dim-fill {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  border-radius: 7rpx;
}
.dim-fill.me { background: #f093fb; }
.dim-fill.other { background: #ffd166; }

.cta-section { margin-bottom: 40rpx; }
.main-btn { width: 100%; margin-bottom: 24rpx; }

.footer-section { text-align: center; padding-top: 20rpx; }
.text-link {
  color: rgba(255, 255, 255, 0.55);
  font-size: 26rpx;
  padding: 20rpx;
}

.loading-view {
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
}
.loading-text { color: rgba(255, 255, 255, 0.6); }

/* 小程序码浮层 */
.qrcode-float {
  position: fixed;
  right: 24rpx;
  bottom: 60rpx;
  width: 160rpx;
  height: 160rpx;
  z-index: 100;
}

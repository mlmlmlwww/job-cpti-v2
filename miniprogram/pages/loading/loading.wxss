.loading-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.spiral-loader {
  width: 180rpx;
  height: 180rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 80rpx;
}
.spiral-ring {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  border: 8rpx solid transparent;
  border-top-color: #f093fb;
  border-right-color: #f5576c;
  animation: spin 2s linear infinite;
  box-shadow: 0 0 50rpx rgba(240, 147, 251, 0.2);
  position: absolute;
}
.spiral-inner {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  border: 6rpx solid transparent;
  border-bottom-color: #f093fb;
  border-left-color: #f5576c;
  animation: spin 1.5s linear infinite reverse;
  position: absolute;
}
.spiral-core {
  width: 16rpx;
  height: 16rpx;
  background: linear-gradient(135deg, #f093fb, #f5576c);
  border-radius: 50%;
  box-shadow: 0 0 30rpx rgba(245, 87, 108, 0.5);
  position: absolute;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.loading-text {
  font-size: 32rpx;
  color: #fff;
  font-weight: 500;
  text-align: center;
}